# Copy to .env (local) and set the same variables in Cloudflare Pages
# (Settings -> Environment variables). These are PUBLIC values baked into the
# static build — never put private API keys or secrets here.

# Formspree form endpoint, e.g. https://formspree.io/f/abcdwxyz
VITE_FORMSPREE_ENDPOINT=

# Scheduling page, e.g. https://calendly.com/your-name
# or a Google Calendar appointment schedule link
VITE_SCHEDULING_URL=
